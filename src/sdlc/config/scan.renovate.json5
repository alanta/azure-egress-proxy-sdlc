// Renovate configuration the scan always applies, whatever the subject. It adds
// dependency sources Renovate doesn't read on its own. Subject-specific sources belong in
// the subject's own policy file instead.
{
  // Report the newest patch as well as the newest minor and major, rather than folding
  // patches into the minor candidate: the scan records a candidate per update type.
  separateMinorPatch: true,

  customManagers: [
    {
      // `pip install "pkg[extra]==1.2.3"` inside a Dockerfile, with no requirements file.
      customType: "regex",
      description: "Pinned pip installs in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile[^/]*$/"],
      matchStrings: [
        "pip3? install[^\\n]*?[\"']?(?<depName>[A-Za-z0-9][A-Za-z0-9._-]*)(?:\\[[^\\]]*\\])?==(?<currentValue>[^\"'\\s]+)",
      ],
      datasourceTemplate: "pypi",
    },
    {
      // Tools installed with `go install module/path@v1.2.3` in workflows and scripts,
      // such as govulncheck and actionlint. Nothing else tracks these pins.
      customType: "regex",
      description: "go install pins",
      managerFilePatterns: ["**/*.yml", "**/*.yaml", "**/*.sh", "**/Dockerfile*"],
      matchStrings: ["go install (?<depName>[a-z0-9.-]+\\.[a-z]+/[^@\\s]+)@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "go",
    },
    {
      // Bicep public registry modules, such as Azure Verified Modules:
      // `br/public:avm/res/compute/virtual-machine-scale-set:0.11.1`. The registry
      // publishes them as OCI artifacts at mcr.microsoft.com/bicep/<path>.
      customType: "regex",
      description: "Bicep public registry module versions",
      managerFilePatterns: ["/\\.bicep$/"],
      matchStrings: [
        "br/public:(?<depName>[a-z0-9/._-]+):(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      packageNameTemplate: "mcr.microsoft.com/bicep/{{{depName}}}",
      datasourceTemplate: "docker",
      versioningTemplate: "semver",
    },
  ],
}
